# Copy this file to .env and replace the placeholder. .env is gitignored.
# Do not commit real Discord webhook URLs.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/000000000000000000/PLACEHOLDER_NOT_A_REAL_SECRET

# Optional: absolute path to a desktop config file outside the repo.
# If unset, the desktop app uses git_reporter_desktop/desktop_config.local.json
# when that file exists, otherwise the per-user GitReporter config.
# GITREPORTER_CONFIG=
